# ==============================================================================
# WAYLAND / WINDOW SETTINGS
# ==============================================================================
wayland_titlebar_color          background
remember_window_size            no
initial_width                   940
initial_height                  520
window_padding_width            12
placement_strategy              center
hide_window_decorations         yes

# Smooth window behaviors
confirm_os_window_close         0
default_layout                  tall

# Subtle background blur
dynamic_background_opacity      yes
background_opacity              0.85
background_blur                 20

# ==============================================================================
# FONTS & RENDERING
# ==============================================================================
font_family                     Spleen
bold_font                       auto
italic_font                     auto
bold_italic_font                auto
font_size                       10

text_composition_strategy       platform
url_style                       curly
url_color                       #E9A929
detect_urls                     yes

symbol_map U+4E00-U+9FFF Zen Kaku Gothic New

# ==============================================================================
# CURSOR & MOUSE
# ==============================================================================
cursor                          #00ff00
cursor_text_color               #181e2b
cursor_shape                    beam
cursor_blink_interval           0.6
cursor_stop_blinking_after      15.0
mouse_hide_wait                 3.0

# ==============================================================================
# RETRO VIBES CUSTOM PALETTE
# ==============================================================================
foreground                      #C4CCE4
background                      #181E2B
selection_foreground            #C4CCE4
selection_background            #39475f

#: The basic 16 colors (Mapped to the Retro Vibes theme)

# Black / Grey
color0                          #000000
color8                          #555555

# Red
color1                          #cd3131
color9                          #ff877e

# Green
color2                          #00aa00
color10                         #58ff77

# Yellow
color3                          #ffbb00
color11                         #ffff2b

# Blue
color4                          #0048ff
color12                         #6e8bff

# Magenta
color5                          #C322AD
color13                         #ffc4d6

# Cyan
color6                          #00a2ca
color14                         #88fcdd

# White
color7                          #aaaaaa
color15                         #e5e5e5

# ==============================================================================
# PERFORMANCE & INTERACTION
# ==============================================================================
scrollback_lines                10000
enable_audio_bell               no

allow_remote_control            yes
listen_on                       unix:/tmp/kitty
clipboard_control               write-clipboard write-primary read-clipboard read-primary
shell_integration               enabled

# ==============================================================================
# KEYBINDINGS
# ==============================================================================
map ctrl+shift+v                paste_from_clipboard
map ctrl+shift+c                copy_to_clipboard
map ctrl+shift+t                new_tab
map ctrl+shift+w                close_tab
map ctrl+shift+left             neighboring_window left
map ctrl+shift+right            neighboring_window right
map ctrl+shift+up               neighboring_window up
map ctrl+shift+down             neighboring_window down
