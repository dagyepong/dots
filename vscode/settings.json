{
    "workbench.iconTheme": "file-icons",
    "workbench.colorTheme": "2077",
    "git.confirmSync": false,
    "git.autofetch": true,
    "git.enableSmartCommit": true,

    "workbench.colorCustomizations": {
        "editor.background": "#171717",
        "editor.foreground": "#CCD0CF",
        "editorLineNumber.foreground": "#686C69",
        "editorLineNumber.activeForeground": "#F25623",
        "editorCursor.foreground": "#F25623",
        "editor.selectionBackground": "#2A2A2A",
        "editor.lineHighlightBackground": "#222222",
        "sideBar.background": "#171717",
        "sideBar.foreground": "#CCD0CF",
        "activityBar.background": "#171717",
        "activityBar.foreground": "#CCD0CF",
        "statusBar.background": "#222222",
        "statusBar.foreground": "#CCD0CF",
        "panel.background": "#171717",
        "input.background": "#222222",
        "input.foreground": "#CCD0CF",
        "focusBorder": "#F25623",
        "list.activeSelectionBackground": "#2A2A2A"
    },

    "editor.tokenColorCustomizations": {
        "textMateRules": [
            {
                "scope": ["comment", "punctuation.definition.comment"],
                "settings": { "foreground": "#686C69", "fontStyle": "italic" }
            },
            {
                "scope": ["keyword", "storage", "keyword.control"],
                "settings": { "foreground": "#F25623" }
            },
            {
                "scope": ["string", "string.quoted"],
                "settings": { "foreground": "#88A57D" }
            },
            {
                "scope": ["constant.numeric", "constant.language"],
                "settings": { "foreground": "#F56E0F" }
            },
            {
                "scope": ["entity.name.function", "support.function"],
                "settings": { "foreground": "#AEAB94" }
            },
            {
                "scope": ["entity.name.type", "support.type", "entity.name.class"],
                "settings": { "foreground": "#959C95" }
            },
            {
                "scope": ["keyword.operator", "punctuation"],
                "settings": { "foreground": "#7D837D" }
            }
        ]
    }
}
