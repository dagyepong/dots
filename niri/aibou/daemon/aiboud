def allowed_path(path):
    try:
        p = Path(os.path.expanduser(str(path))).resolve()
    except (OSError, RuntimeError):
        return None
    if secret_name(p):
        return None
    for d in read_dirs():
        try:
            p.relative_to(d.resolve())
            return p
        except (ValueError, OSError):
            continue
    return None


def run_tool(name, args):
    """What a tool call returns, as text; refusals say why."""
    if name in ("read_file", "list_dir"):
        p = allowed_path(args.get("path", ""))
        if not p:
            return "refused: no files named like secrets, and only inside " + ", ".join(str(d).replace(str(HOME), "~") for d in read_dirs())
        try:
            if name == "list_dir":
                return "\n".join(sorted((e.name + ("/" if e.is_dir() else "")) for e in p.iterdir())[:300]) or "(empty)"
            data = p.read_bytes()[:40000]
            return data.decode("utf-8", "replace")
        except OSError as e:
            return f"error: {e}"
    if name == "run":
        cmd = str(args.get("command", "")).strip()
        if re.search(r"[;&|`$<>\n]", cmd):
            return "refused: one plain command, no pipes, substitution or redirection"
        if not read_allowed(cmd):
            return "refused: not a read-only command from the allowed list"
        if blocked(cmd):
            return "refused: " + blocked(cmd)
        try:
            env = dict(os.environ, PATH=f"{HOME}/.local/bin:{HOME}/bin:" + os.environ.get("PATH", ""))
            r = subprocess.run(shlex.split(cmd), capture_output=True, text=True, timeout=20, env=env, cwd=str(HOME))
            return ((r.stdout or "") + (r.stderr or ""))[-12000:] or f"(exit {r.returncode}, no output)"
        except (OSError, subprocess.SubprocessError, ValueError) as e:
            return f"error: {e}"
    return "unknown tool"


def test_provider(pid):
    """`aiboud --test-provider ID`, for the Test button on the settings page:
    one short question to that provider, the same way the chat asks. Prints one
    JSON line: ok, text (the answer or what went wrong), first/total in ms."""
    global SETTINGS
    SETTINGS = read_settings()
    de = language() == "de"

    def out(**kw):
        print(json.dumps(kw, ensure_ascii=False), flush=True)
        return 0 if kw.get("ok") else 1

    p = provider("p:" + pid)
    if not p:
        return out(ok=False, text="Anbieter nicht gefunden (erst speichern)" if de else "provider not found (save it first)")
    if not p.get("model"):
        return out(ok=False, text="Kein Modell eingetragen" if de else "No model set")
    key = provider_key(pid)
    if not key and not re.match(r"https?://(localhost|127\.|\[::1\])", p.get("url") or ""):
        return out(ok=False, text="Kein Schlüssel im Schlüsselbund" if de else "No key in the keyring")
    t0 = time.monotonic()
    first = []
    pieces = []

    def piece(x):
        if not first:
            first.append(time.monotonic())
        pieces.append(x)

    question = "Sag in einem kurzen Satz hallo." if de else "Say hello in one short sentence."
    system = "Dies ist ein Verbindungstest. Antworte kurz." if de else "This is a connection test. Answer briefly."
    try:
        api_stream(p, key, system, [{"role": "user", "content": question}], piece)
    except Exception as e:  # noqa: BLE001  shown on the settings page as it is
        return out(ok=False, text=str(e)[:300])
    text = "".join(pieces).strip()
    if not text:
        return out(ok=False, text="Leere Antwort" if de else "Empty answer")
    return out(ok=True, text=text[:200], first=round((first[0] - t0) * 1000), total=round((time.monotonic() - t0) * 1000))


