async def lines(*cmd):
    """The output of cmd, line by line. Long lines are fine (a notification
    with an image arrives as one line of several hundred KB); one too long
    even for that is skipped instead of ending everything."""
    proc = await asyncio.create_subprocess_exec(
        *cmd, stdout=asyncio.subprocess.PIPE, stderr=asyncio.subprocess.DEVNULL, limit=32 * 1024 * 1024)
    try:
        while True:
            try:
                raw = await proc.stdout.readline()
            except ValueError:
                log("line too long, skipped:", cmd[0])
                continue
            if not raw:
                break
            yield raw.decode("utf-8", "replace").rstrip("\n")
    finally:
        if proc.returncode is None:
            proc.kill()


POINTER_FAST = [False]     # somebody hangs on the pointer: every movement, not 30 a second


async def pointer_stream():
    """Needs the pointer-stream patch in niri; without it this ends quietly."""
    rx = re.compile(r"Pointer moved: ([-\d.]+), ([-\d.]+)")
    last = 0.0
    async for line in lines("niri", "msg", "pointer-stream"):
        m = rx.search(line)
        if not m:
            continue
        activity.poke()
        now = time.monotonic()
        if now - last < (0.004 if POINTER_FAST[0] else 0.033):
            continue
        last = now
        emit({"t": "pointer", "x": float(m.group(1)), "y": float(m.group(2))})
    log("pointer-stream ended (unpatched niri?)")


class Layout:
    """Where the windows are, as far as niri tells. Tiled windows only carry a
    position with the window-positions patch; without it `known` stays false
    and Aibou assumes there is a window in front of him."""

    def __init__(self):
        self.windows = {}
        self.workspaces = {}
        self.dirty = False
        self.sent = None
        self.patched = False
        self.wake = asyncio.Event()

    def mark(self):
        self.dirty = True
        self.wake.set()

    def fullscreen(self):
        """A window on an active workspace as big as the screen (niri has no
        flag for it in this version): then nothing of Aibou's may lie over it."""
        size = OUTPUT_SIZE[0]
        for w in self.windows.values():
            ws = self.workspaces.get(w.get("workspace_id"))
            if not ws or not ws.get("is_active") or not w.get("is_focused"):
                continue
            ww, wh = (w.get("layout") or {}).get("window_size") or [0, 0]
            if size and ww >= size[0] - 2 and wh >= size[1] - 2:
                return True
        return False

    def visible(self):
        # unknown only while a tiled window lacks its position; no tiled window
        # at all (fresh login, empty workspace) means nothing stands in front
        out, missing = [], False
        for w in self.windows.values():
            lay = w.get("layout") or {}
            pos = lay.get("tile_pos_in_workspace_view")
            ws = self.workspaces.get(w.get("workspace_id"))
            if not w.get("is_floating"):
                if pos is not None:
                    self.patched = True
                else:
                    missing = True
            if pos is None or not ws or not ws.get("is_active"):
                continue
            size = lay.get("tile_size") or [0, 0]
            out.append({"id": w["id"], "output": ws.get("output"), "x": pos[0], "y": pos[1],
                        "w": size[0], "h": size[1], "floating": bool(w.get("is_floating"))})
        return out, self.patched or not missing

    async def flush(self):
        # woken by mark(); at most 30 updates a second while scrolling
        while True:
            await self.wake.wait()
            self.wake.clear()
            if self.dirty:
                self.dirty = False
                lst, known = self.visible()
                full = self.fullscreen()
                # title changes (a terminal spinner) mark it dirty too; only
                # send when where the windows are has changed
                if (lst, known, full) != self.sent:
                    self.sent = (lst, known, full)
                    emit({"t": "windows", "list": lst, "known": known, "fullscreen": full})
            await asyncio.sleep(0.033)


