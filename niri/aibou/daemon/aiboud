        async for line in lines("playerctl", "-a", "--follow", "--format", "{{playerName}}\t{{status}}", "status"):
            name, _, status = line.partition("\t")
            if status:
                PLAYERS[name] = status
            else:
                # a player went away: who is left is asked once
                PLAYERS.clear()
                PLAYERS.update(await asyncio.to_thread(all_players))
        PLAYERS.clear()
        await asyncio.sleep(10)


class BeatTracker:
    """Beats from cava's two lowest bands.
    1. Onsets: the bass's rise from one frame to the next (not its level, which
       stays high between kicks), over its own running mean + spread.
    2. Tempo: autocorrelation of that rise over the last 6 s, 90–240 per
       minute; the scene dances fast music in half time.
    3. A running grid: beats come on time from the tempo, onsets pull the grid
       into phase, a missing kick is filled in. Without a steady tempo (no
       onset on the grid for a while) the onsets themselves are the beats."""
    LO, HI = 60 / 240, 60 / 90           # every kick up to 240 per minute (frenchcore)
    def __init__(self, fps=None):
        fps = fps or CAVA_FPS
        self.fps = fps
        self.prev = 0.0
        self.flux = deque(maxlen=round(1.5 * fps))     # 1.5 s of rises for the onset threshold
        self.fsum = self.fsq = 0.0                      # their running sum and sum of squares
        self.last_onset = -1.0
        self.rising = False
        self.onsets = deque(maxlen=24)
        self.period = 0.0
        self.next = 0.0
        self.miss = 0
        self.matched = False
        self.strength = 0.5
        self.last_tempo = 0.0
        self.bpm = 0.0
        self.pending = 0.0
        self.hist = deque(maxlen=round(6 * fps))   # 6 s of the bass's rise, for the tempo
        self.times = deque(maxlen=round(6 * fps))
    def tempo(self, now):
        """the beat period from the autocorrelation of the bass's rise over the
        last 6 s. Each lag counts with its multiples up to four (a comb): only
        the true period lines the kicks up at every one of them, a rolling bass
        between the kicks (psytrance) would otherwise win with 3/4 of a beat"""
        f = list(self.hist)
        n = len(f)
        if n < 4 * self.fps: return 0.0
        dt = (self.times[-1] - self.times[0]) / (len(self.times) - 1)
        m = sum(f) / n
        f = [x - m for x in f]
        lo, hi = max(2, int(self.LO / dt)), int(self.HI / dt) + 1
        ac = {}
        def corr(l):
            if l not in ac:
                ac[l] = sum(f[i] * f[i + l] for i in range(n - l)) / (n - l)
            return ac[l]
        best, bl = 0.0, 0
        for l in range(lo, hi + 1):
            sc = sum(corr(k * l) for k in range(1, 5) if k * l < n - self.fps)
            if sc > best: best, bl = sc, l
        if bl == 0 or corr(bl) <= 0 or corr(bl) < 0.08 * corr(0): return 0.0
        # between frames: a parabola through the neighbours
        a, b, c = corr(bl - 1), corr(bl), corr(bl + 1)
        d = a - 2 * b + c
        frac = 0.5 * (a - c) / d if d < 0 else 0.0
        return (bl + max(-0.5, min(0.5, frac))) * dt
    def rephase(self, now):
        """the grid's phase: the mean phase of the last 4 s of onsets on a circle
        of one period, weighted by strength; far off it jumps, near it follows"""
        p = self.period
        c = sn = 0.0
        for t, w in self.onsets:
            if now - t < 4:
                a = 2 * math.pi * t / p
                c += w * math.cos(a); sn += w * math.sin(a)
        if math.hypot(c, sn) < 1.0: return
        off = (math.atan2(sn, c) / (2 * math.pi)) * p       # a beat falls at off + k p
        target = off + math.ceil((now - off) / p) * p
        if not self.next:
            self.next = target; return
        d = (target - self.next + p / 2) % p - p / 2
        self.next += d if abs(d) > 0.25 * p else 0.5 * d
        if self.next < now - 0.01: self.next += p
    def flux_stats(self):
        """mean and spread of the recent rises (kept as running sums: this
        runs for every frame)"""
        n = len(self.flux)
        m = self.fsum / n
        return m, math.sqrt(max(0.0, self.fsq / n - m * m))

    def feed(self, now, bands):
        out = []
        bass = 0.6 * bands[0] + 0.4 * bands[1]
        f = max(0.0, bass - self.prev)
        self.prev = bass
        if len(self.flux) > self.fps / 3:
            m, sd = self.flux_stats()
            onset = f > m + 1.5 * sd + 6 and not self.rising and now - self.last_onset > 0.15
        else:
            onset = False
        self.rising = f > 0 and (self.rising or onset)
        if f == 0: self.rising = False
        if len(self.flux) == self.flux.maxlen:
            old = self.flux[0]
            self.fsum -= old; self.fsq -= old * old
        self.flux.append(f)
        self.fsum += f; self.fsq += f * f
        self.hist.append(f)
        self.times.append(now)
        if onset:
            self.last_onset = now
            m, sd = self.flux_stats()
            s = min(1.0, f / (m + 3 * sd + 1))
            self.onsets.append((now, s))
            self.strength = 0.7 * self.strength + 0.3 * s
        # the tempo, twice a second
        if now - self.last_tempo > 0.5:
            self.last_tempo = now
            p = self.tempo(now)
            # a new tempo has to win twice in a row before it replaces the old
            if p and self.period and abs(p - self.period) > 0.06 * self.period:
                if self.pending and abs(p - self.pending) < 0.06 * p:
                    self.period = p; self.next = 0.0; self.miss = 0; self.pending = 0.0
                else:
                    self.pending = p
            elif p and not self.period:
                self.period = p; self.next = 0.0; self.miss = 0
            elif p:
                self.period += 0.3 * (p - self.period)
                self.pending = 0.0
            self.bpm = 60 / self.period if self.period else 0
            if self.period: self.rephase(now)
        if not self.period:
            if onset: out.append(now)
            return out
        if onset:
            if not self.next:
                self.next = now + self.period
                out.append(now)
                self.matched = True
                return out
            # where the onset falls on the grid: -0.5 … 0.5 of a period from the nearest beat
            ph = (now - (self.next - self.period)) / self.period
            ph -= round(ph)
            if abs(ph) < 0.2:
                self.next += 0.4 * ph * self.period
                self.matched = True
        # a frame ahead: the caller schedules the beat for its exact time
        if self.next and now >= self.next - 1 / self.fps:
            out.append(self.next)
            self.miss = 0 if self.matched else self.miss + 1
            self.matched = False
            self.next += self.period
            if self.miss > 8:          # lost the beat: back to plain onsets
                self.period = 0.0; self.next = 0.0; self.miss = 0; self.bpm = 0
        return out


def beat_delay():
    """seconds to hold each beat back: cava hears the sound before Bluetooth
    headphones play it (150–250 ms). Setting `beatDelay` in ms, else 180 ms
    on a Bluetooth output and none on any other."""
    if SETTINGS.get("beatDelay") not in (None, ""):
        try:
            return max(0.0, float(SETTINGS["beatDelay"]) / 1000)
        except (TypeError, ValueError):
            pass
    try:
        sink = subprocess.run(["pactl", "get-default-sink"], capture_output=True, text=True, timeout=5).stdout
    except (OSError, subprocess.SubprocessError):
        return 0.0
    return 0.18 if sink.startswith("bluez_") else 0.0


async def beats():
    """cava's lowest bands, while music plays, through the BeatTracker: beats
    on a steady grid once the tempo is known, else the onsets of the bass."""
    conf = STATE / "cava.conf"
    conf.write_text(CAVA_CONF)
    proc = await asyncio.create_subprocess_exec(
        "cava", "-p", str(conf), stdin=asyncio.subprocess.DEVNULL,
        stdout=asyncio.subprocess.PIPE, stderr=asyncio.subprocess.DEVNULL)
    tracker = BeatTracker()
    delay = await asyncio.to_thread(beat_delay)
    loop = asyncio.get_running_loop()
    try:
        async for raw in proc.stdout:
            try:
                bands = [int(v) for v in raw.decode().strip().strip(";").split(";")]
                if len(bands) < 2:
                    continue
            except ValueError:
                continue
            now = time.monotonic()
            for at in tracker.feed(now, bands):
                msg = {"t": "beat", "s": round(min(1.0, max(0.2, tracker.strength)), 2), "bpm": round(tracker.bpm)}
                wait = max(0.0, at - now) + delay
                if wait > 0:
                    loop.call_later(wait, emit, msg)
                else:
                    emit(msg)
    finally:
        if proc.returncode is None:
            proc.kill()
            await proc.wait()


async def music():
    on = None
    task = None
    while True:
        now = await asyncio.to_thread(playing)
        if now != on:
            on = now
            emit({"t": "music", "on": on})
        want = on and SETTINGS.get("dance", True)
        if want and task is None:
            task = asyncio.create_task(beats())
        elif not want and task is not None:
            task.cancel()
            task = None
        elif task is not None and task.done():
            task = None              # cava ended; started again on the next round
        await asyncio.sleep(3)


# ── his domes drawn by DMS, as part of its frame ──────────────────

class FrameHost:
    """DMS with dms-leiste-patch 14 takes a list of bodies over IPC and draws
    them in its connected frame. Asked again now and then, because DMS may
    have restarted (then it lost the list, which is sent again)."""
    def __init__(self):
        self.on = None
        self.offsets = False                # DMS draws domes at a popout's edge
        self.sending = False
        self.corners = False                # ... as a round bump on its corner
        self.domes = 3                      # how many domes DMS can draw
        self.bodies = "[]"

    def call(self, *args):
        try:
            r = subprocess.run(["dms", "ipc", "call", "aibouFrame", *args], capture_output=True, text=True, timeout=5)
            return r.stdout.strip()
        except (OSError, subprocess.SubprocessError):
            return ""

    async def send(self, bodies):
        """Only the latest list goes out; while one call runs, newer ones wait
        and replace each other."""
        self.bodies = bodies
        if not self.on or self.sending:
            return
        self.sending = True
        try:
            sent = None
            while sent != self.bodies and self.on:
                sent = self.bodies
                await asyncio.to_thread(self.call, "set", sent)
        finally:
            self.sending = False

    @staticmethod
    def dms_pid():
        """The running `dms run`, from /proc (DMS may run as a service or be
        started by niri); "" when there is none."""
        try:
            for d in Path("/proc").iterdir():
                if not d.name.isdigit():
                    continue
                try:
                    if (d / "comm").read_text().strip() != "dms":
                        continue
                    if b"\0run\0" in (d / "cmdline").read_bytes() + b"\0":
                        return d.name
                except OSError:
                    continue
        except OSError:
            pass
        return ""

    async def watch(self):
        """Asked once at the start and after each DMS restart (then DMS forgot
        the domes, they are sent again). A stock DMS does not know aibouFrame:
        after that one failed call it is not asked again until DMS restarts.
        One that answers is asked every 30 s, in case it lost the patch."""
        pid, last_ping = None, None
        while True:
            # the known DMS process still there: nothing to look up
            alive = bool(pid) and Path(f"/proc/{pid}").exists()
            now_pid = pid if alive else await asyncio.to_thread(self.dms_pid)
            restarted = pid is not None and now_pid != pid
            pid = now_pid
            if restarted:
                BACKDROP_CHECK.set()
            due = last_ping is None or (self.on and time.monotonic() - last_ping > 30)
            if now_pid and (restarted or due):
                if restarted:
                    await asyncio.sleep(3)          # DMS needs a moment for its IPC
                last_ping = time.monotonic()
                pong = (await asyncio.to_thread(self.call, "ping")).split()
                on = pong[:1] == ["ok"]
                offsets = "o" in pong[1:]
                corners = "c" in pong[1:]
                domes = 5 if "5" in pong[1:] else 3
                if on != self.on or offsets != self.offsets or corners != self.corners or domes != self.domes or restarted:
                    self.on, self.offsets, self.corners, self.domes = on, offsets, corners, domes
                    emit({"t": "frameHost", "on": on, "offsets": offsets, "corners": corners, "domes": domes})
                if on:      # also an empty list: DMS may still hold domes of an earlier run
                    await asyncio.to_thread(self.call, "set", self.bodies)
            # without a DMS process it is looked for less often (a /proc scan)
            await asyncio.sleep(5 if pid else 30)


