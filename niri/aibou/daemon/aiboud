#!/usr/bin/env python3
"""Aibou's daemon. Runs as a child of the Quickshell scene and talks JSON lines.

stdout (to the scene):
  {"t":"pointer","x":..,"y":..}      global logical position, at most ~30 per second
  {"t":"activity"}                    the user did something, at most every 3 s
  {"t":"notify","app","summary","body","urgency"}
  {"t":"focus","id","app","title"}    id null: no window has the focus
  {"t":"windows","list":[{id,output,x,y,w,h,floating}],"known":bool}   output-local, active workspaces
  {"t":"overview","open":bool}
  {"t":"thinking"}  {"t":"delta","text"}  {"t":"say","text","mood"}  {"t":"error","text"}
  {"t":"model","name"}               the session's model (haiku, sonnet, opus)
  {"t":"tool","name","what"}         he looks something up (desktop help)
  {"t":"actions","list":[{id,cmd,blocked}]}   proposed changes, shown as cards
  {"t":"ran","id","code","out"}      a confirmed action ran
  {"t":"settings","values":{...}}   Aibou's part of DMS plugin_settings.json
  {"t":"insets","left","right","top","bottom"}  {"t":"colors",...}  {"t":"power","mains":bool}
  {"t":"load","cpu","ram","temp","strain"}   how hard the machine works; strain 0 … 1
  {"t":"trouble","kind":"crash"|"unit","name"}   a program crashed, a service failed
  {"t":"barspot","y"}                where his face fits into the bar (null: nowhere)
  {"t":"wallpaper","path"}           the desktop wallpaper, shown under a lifted window
  {"t":"frameHost","on":bool}        DMS draws his domes as part of its frame (dms-leiste-patch 14)
  {"t":"music","on":bool}            some player plays (MPRIS)
  {"t":"beat","s","bpm"}             a beat, strength 0 … 1, tempo per minute (0 unknown); only while music plays
  {"t":"recording","on":bool,"by"}   the screen is being recorded or cast
  {"t":"download","name"}            a download landed in ~/Downloads
  {"t":"battery","level","charging"} battery percent (only on change)
  {"t":"updates","count"}            packages with updates (checkupdates, every 3 h)
  {"t":"jobDone","name","secs"}      a build or package run that took over a minute has ended
  {"t":"locked","on":bool,"away"}    the screen was locked / unlocked (away: seconds it was locked)
  {"t":"usb","name"}                 a USB drive was plugged in
  {"t":"mic","on":bool,"by"}         a program listens to a microphone (not a monitor of the output)
  {"t":"kuroWall","on":bool,"light":bool}   the Kuro wallpaper is up (the scene animates its eyes)
  {"t":"restack"}                    another backdrop surface lies over ours: build ours again
stdin (from the scene):
  {"t":"chat","text":".."}  {"t":"warm"}  {"t":"model","name":".."}  {"t":"forget"}
  {"t":"run","id","cmd"}  {"t":"decline","id"}
  {"t":"barspot","x","w","top","bottom","need","skip":[a,b]|null}   look for room in the bar
  {"t":"frameBodies","list":[{screen,side,p,w,h,f}]}   domes for DMS to draw in its frame
"""
