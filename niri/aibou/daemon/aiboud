# ── shell geometry and colours ────────────────────────────────────

def insets():
    """Free area inside the DMS frame and bars, in logical pixels, and the
    edge the (first visible) bar sits on."""
    out = {"left": 0, "right": 0, "top": 0, "bottom": 0, "bar": ""}
    try:
        s = json.loads(DMS_SETTINGS.read_text())
    except (OSError, ValueError):
        return out
    frame = s.get("frameThickness", 0) if s.get("frameEnabled") else 0
    for k in ("left", "right", "top", "bottom"):
        out[k] = frame
    bar = s.get("frameBarSize", 40)
    sides = {0: "top", 1: "bottom", 2: "left", 3: "right", 4: "top", 5: "bottom"}
    for b in s.get("barConfigs", []):
        if not b.get("enabled") or b.get("autoHide"):
            continue
        side = sides.get(b.get("position", 0))
        if side:
            out[side] = max(out[side], bar)
            out["bar"] = out["bar"] or side
    return out


def niri_gap():
    """The gap between windows and the screen edge, from the niri layout."""
    gap = 16
    for f in (HOME / ".config/niri/config.kdl", HOME / ".config/niri/dms/layout.kdl"):
        try:
            m = re.findall(r"^\s*gaps\s+([\d.]+)", f.read_text(), re.M)
        except OSError:
            continue
        if m:
            gap = float(m[-1])
    return gap


def colors():
    try:
        d = json.loads(DMS_COLORS.read_text())
        c = d["colors"][d.get("mode", "dark")]
        try:
            # DMS leaves out values at their default (1.0 for frameOpacity)
            glass = float(json.loads(DMS_SETTINGS.read_text()).get("frameOpacity", 1.0))
        except (OSError, ValueError, TypeError):
            glass = 0.65
        try:
            fc = json.loads(DMS_SETTINGS.read_text()).get("frameColor", "")
        except (OSError, ValueError):
            fc = ""
        # as DMS resolves it (SettingsData.effectiveFrameColor)
        frame = {"": c["surface_container"], "default": c["surface_container"],
                 "primary": c["primary"], "surface": c["surface"]}.get(fc, fc)
        return {"primary": c["primary"], "surface": c["surface_container_high"],
                "base": c["surface"], "glass": glass, "frame": frame,
                "text": c["on_surface"], "outline": c["outline"], "dark": d.get("mode") != "light"}
    except (OSError, ValueError, KeyError):
        return {}


def on_mains():
    """True when any non-battery supply is online."""
    root = Path("/sys/class/power_supply")
    for d in root.iterdir() if root.exists() else []:
        try:
            if (d / "type").read_text().strip() != "Battery" and (d / "online").read_text().strip() == "1":
                return True
        except OSError:
            pass
    return not any((d / "type").read_text().strip() == "Battery" for d in root.iterdir()) if root.exists() else True


def dms_settings():
    try:
        return json.loads(PLUGIN_SETTINGS.read_text()).get("aibou", {})
    except (OSError, ValueError):
        return {}


# What the chat changed (activity, figures more or fewer) stays in Aibou's own
# state, {key: {"value", "base"}}, and lies over DMS's settings; DMS's file is
# never written from here. The settings page takes these over into DMS when it
# opens. A key whose DMS value is no longer "base" (taken over, or changed in
# DMS) is dropped again.
CHOSEN = STATE / "chosen.json"


def read_chosen():
    try:
        data = json.loads(CHOSEN.read_text())
        return data if isinstance(data, dict) else {}
    except (OSError, ValueError):
        return {}


def write_chosen(data):
    STATE.mkdir(parents=True, exist_ok=True)
    tmp = CHOSEN.with_name(CHOSEN.name + ".tmp")
    tmp.write_text(json.dumps(data, indent=2, ensure_ascii=False))
    os.replace(tmp, CHOSEN)


def read_settings():
    """DMS's settings for Aibou with the chat's choices over them."""
    dms = dms_settings()
    chosen = read_chosen()
    keep = {k: c for k, c in chosen.items() if isinstance(c, dict) and dms.get(k) == c.get("base")}
    if keep != chosen:
        write_chosen(keep)
    return {**dms, **{k: c["value"] for k, c in keep.items()}}


def choose(values):
    """Changes from the chat into Aibou's own state, then on to the scene."""
    global SETTINGS
    dms = dms_settings()
    chosen = read_chosen()
    for k, v in values.items():
        if dms.get(k) == v:
            chosen.pop(k, None)
        else:
            chosen[k] = {"value": v, "base": dms.get(k)}
    write_chosen(chosen)
    SETTINGS = read_settings()
    emit({"t": "settings", "values": {**SETTINGS, "userName": user_name()}})


SESSION = HOME / ".local/state/DankMaterialShell/session.json"


def do_not_disturb():
    """DMS's do not disturb, from its session file (only written when on;
    with a duration it ends by itself at doNotDisturbUntil)."""
    try:
        s = json.loads(SESSION.read_text())
    except (OSError, ValueError):
        return False
    if not s.get("doNotDisturb"):
        return False
    until = s.get("doNotDisturbUntil") or 0
    return until <= 0 or until > time.time() * 1000


def option(key, default):
    """One of Aibou's settings as a bool (DMS stores true/false, older files strings)."""
    v = SETTINGS.get(key, default)
    return v if isinstance(v, bool) else str(v).lower() in ("true", "1", "on", "yes")


# settings the scene may change by itself (the chat window), and their values
SETTABLE = {"activity": ("minimal", "calm", "normal", "lively", "max")}


def set_option(key, value):
    """One Aibou setting changed from the chat."""
    if value in SETTABLE.get(key, ()):
        choose({key: value})


def change_buddies(delta):
    """One figure more (in the first free place, a look not taken yet) or one
    less (the last one)."""
    m = read_settings()
    slots = ["skin2", "skin3", "skin4", "skin5"]
    if delta > 0:
        free = [k for k in slots if m.get(k, "none") == "none"]
        if not free:
            return
        used = {m.get("skin1", "kuro"), *(m.get(k) for k in slots)}
        looks = [s for s in ("kuro", "mochi", "shiro", "momo", "robo", "bao", "neko", "kumo", "tako", "hiyoko", "arai") if s not in used]
        if not looks:
            return
        choose({free[0]: random.choice(looks)})
    else:
        taken = [k for k in slots if m.get(k, "none") != "none"]
        if not taken:
            return
        choose({taken[-1]: "none"})


def user_name():
    """Who the figures talk to: the setting "userName", else the first name
    of the account's full name, else the login name."""
    n = str(SETTINGS.get("userName") or "").strip()
    if n:
        return n
    try:
        full = pwd.getpwuid(os.getuid()).pw_gecos.split(",")[0].strip()
        if full:
            return full.split()[0]
    except (KeyError, IndexError):
        pass
    return os.environ.get("USER", "").capitalize() or "you"


async def watch_settings():
    """DMS writes plugin_settings.json; pass Aibou's part on when it changes."""
    global SETTINGS
    last = None
    while True:
        try:
            stamp = PLUGIN_SETTINGS.stat().st_mtime
        except OSError:
            stamp = None
        if stamp != last:
            last = stamp
            new = read_settings()
            if new != SETTINGS or stamp is None:
                SETTINGS = new
            emit({"t": "settings", "values": {**SETTINGS, "userName": user_name()}})
        await asyncio.sleep(2)


