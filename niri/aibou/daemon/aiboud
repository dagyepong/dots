# ── how the machine is doing ──────────────────────────────────────

def cpu_times():
    with open("/proc/stat") as f:
        v = [int(x) for x in f.readline().split()[1:]]
    return v[3] + v[4], sum(v)          # idle + iowait, total


def ram_used():
    m = {}
    with open("/proc/meminfo") as f:
        for line in f:
            k, v = line.split(":", 1)
            m[k] = int(v.split()[0])
    return 100 * (1 - m["MemAvailable"] / m["MemTotal"])


def cpu_temp():
    """The package temperature (coretemp, k10temp, zenpower), or None."""
    for d in Path("/sys/class/hwmon").glob("hwmon*"):
        try:
            if (d / "name").read_text().strip() in ("coretemp", "k10temp", "zenpower"):
                return int((d / "temp1_input").read_text()) / 1000
        except (OSError, ValueError):
            pass
    return None


async def load_watch():
    """Every 2 s; the CPU load is averaged over about 20 s, so a short build
    does not make him sweat but a long one does. Sent only when the strain
    moves by a step, so the scene is not woken for nothing."""
    idle0, total0 = cpu_times()
    cpu = 0.0
    sent = None
    while True:
        await asyncio.sleep(2)
        try:
            idle, total = cpu_times()
            now = 100 * (1 - (idle - idle0) / max(1, total - total0))
            idle0, total0 = idle, total
            cpu += (now - cpu) * 0.1
            ram = ram_used()
        except (OSError, ValueError, KeyError):
            continue
        temp = cpu_temp()
        strain = max((cpu - 55) / 35, (ram - 82) / 14, ((temp or 0) - 82) / 14, 0)
        strain = round(min(1, strain) * 10) / 10
        if strain != sent:
            sent = strain
            emit({"t": "load", "cpu": round(cpu), "ram": round(ram),
                  "temp": round(temp) if temp else None, "strain": strain})


async def crashes():
    """Programs that dumped core, from systemd-coredump in the journal."""
    while True:
        async for line in lines("journalctl", "-f", "-n", "0", "-o", "json", "-t", "systemd-coredump"):
            try:
                e = json.loads(line)
            except ValueError:
                continue
            name = e.get("COREDUMP_COMM")
            if name:
                emit({"t": "trouble", "kind": "crash", "name": name})
        await asyncio.sleep(30)


# ── the machine, more of it: recording, downloads, battery, updates, long jobs ──

RECORDERS = ("wf-recorder", "obs", "gpu-screen-recorder", "kooha", "wl-screenrec", "simplescreenrecorder")


CASTS = [[]]                # niri's casts, from its event stream (CastsChanged)
CASTS_CHANGED = asyncio.Event()
RECORDING_PROGS = [""]      # a recording program, from the program scan (setting watchSystem)


def recording_now():
    """Who records the screen: a cast in niri (screen sharing, portal
    recorders) or a known recording program; "" when nobody."""
    if CASTS[0]:
        c = CASTS[0][0] if isinstance(CASTS[0], list) else {}
        return str((c or {}).get("app_id") or (c or {}).get("name") or "cast")
    return RECORDING_PROGS[0] if option("watchSystem", False) else ""


async def recording():
    was = ""
    while True:
        now = await asyncio.to_thread(recording_now)
        if bool(now) != bool(was):
            emit({"t": "recording", "on": bool(now), "by": now or was})
        was = now
        # woken by niri's casts and by the program scan
        await CASTS_CHANGED.wait()
        CASTS_CHANGED.clear()


DOWNLOADS = HOME / "Downloads"
PARTIAL = (".part", ".crdownload", ".tmp", ".download", ".partial", ".!qB", ".aria2")


async def downloads():
    """Files that are finished in ~/Downloads (written and closed, or renamed
    from a browser's .part); half-done ones and hidden files do not count."""
    if not DOWNLOADS.is_dir():
        return
    proc = await asyncio.create_subprocess_exec(
        "inotifywait", "-m", "-q", "-e", "close_write,moved_to", "--format", "%f", str(DOWNLOADS),
        stdout=asyncio.subprocess.PIPE, stderr=asyncio.subprocess.DEVNULL, stdin=asyncio.subprocess.DEVNULL)
    last = {}
    try:
        async for raw in proc.stdout:
            name = raw.decode(errors="replace").strip()
            if not name or name.startswith(".") or name.endswith(PARTIAL):
                continue
            now = time.monotonic()
            if now - last.get(name, -99) < 15:
                continue
            last[name] = now
            emit({"t": "download", "name": name})
    finally:
        if proc.returncode is None:
            proc.kill()


def battery_now():
    root = Path("/sys/class/power_supply")
    for d in root.iterdir() if root.exists() else []:
        try:
            if (d / "type").read_text().strip() != "Battery":
                continue
            level = int((d / "capacity").read_text().strip())
            status = (d / "status").read_text().strip()
            return level, status in ("Charging", "Full")
        except (OSError, ValueError):
            continue
    return None


async def battery():
    was = None
    while True:
        now = await asyncio.to_thread(battery_now)
        if now and now != was:
            emit({"t": "battery", "level": now[0], "charging": now[1]})
        was = now
        await asyncio.sleep(60)


async def updates():
    """Pending package updates (checkupdates uses its own copy of the
    package database, so nothing is changed); every three hours."""
    await asyncio.sleep(120)
    while True:
        def count():
            try:
                r = subprocess.run(["checkupdates"], capture_output=True, text=True, timeout=180)
            except (OSError, subprocess.SubprocessError):
                return None
            # 0 with a list, 2 with none; anything else: could not check
            if r.returncode == 2:
                return 0
            if r.returncode != 0:
                return None
            return len([l for l in r.stdout.splitlines() if l.strip()])
        n = await asyncio.to_thread(count)
        if n is not None:
            emit({"t": "updates", "count": n})
        await asyncio.sleep(3 * 3600)


# builds and package runs: the program names that count as such a job
JOBS = {"make": "build", "cmake": "build", "ninja": "build", "cargo": "build", "meson": "build",
        "gradle": "build", "mvn": "build", "go": "build", "npm": "build", "pnpm": "build", "yarn": "build",
        "makepkg": "build", "docker": "build", "podman": "build",
        "pacman": "update", "paru": "update", "yay": "update", "flatpak": "update"}
# these also start things that run until stopped (npm run dev, docker compose up,
# flatpak run): they count only with one of these words on their command line
JOB_WORDS = {"npm": "build|install|ci|test", "pnpm": "build|install|test", "yarn": "build|install|test",
             "go": "build|install|test", "docker": "build", "podman": "build", "flatpak": "update|install"}


async def programs():
    """One look at the running programs every 15 s (only with the setting
    watchSystem): a job from JOBS that ran over a minute and has now ended,
    and whether a recording program runs. Only the outermost job of a kind
    counts (make under makepkg is part of it)."""
    seen = {}                                  # pid -> (name, started, seconds since boot)
    hz = os.sysconf("SC_CLK_TCK")
    try:
        while True:
            await programs_once(seen, hz)
            await asyncio.sleep(15)
    finally:
        if RECORDING_PROGS[0]:
            RECORDING_PROGS[0] = ""
            CASTS_CHANGED.set()


def scan_programs(hz):
    """Running jobs from JOBS {pid: (name, age in s)} and the first recording program."""
    out = {}
    rec = ""
    try:
        up = float(Path("/proc/uptime").read_text().split()[0])
    except (OSError, ValueError):
        up = 0.0
    for d in Path("/proc").iterdir():
        if not d.name.isdigit():
            continue
        try:
            name = (d / "comm").read_text().strip()
            if name in RECORDERS:
                rec = rec or name
            if name not in JOBS:
                continue
            stat = (d / "stat").read_text()
            fields = stat[stat.rindex(")") + 2:].split()
            ppid = int(fields[1])
            # when it really started (field 22 of stat, in clock ticks since boot)
            age = up - int(fields[19]) / hz
            parent = (Path("/proc") / str(ppid) / "comm").read_text().strip()
        except (OSError, ValueError, IndexError):
            continue
        if parent in JOBS:
            continue
        if name in JOB_WORDS:
            try:
                cmd = (d / "cmdline").read_bytes().replace(b"\0", b" ").decode(errors="replace")
            except OSError:
                continue
            if not re.search(r"\b(" + JOB_WORDS[name] + r")\b", cmd):
                continue
        out[int(d.name)] = (name, age)
    return out, rec


async def programs_once(seen, hz):
    now, rec = await asyncio.to_thread(scan_programs, hz)
    if rec != RECORDING_PROGS[0]:
        RECORDING_PROGS[0] = rec
        CASTS_CHANGED.set()
    t = time.monotonic()
    for pid, (name, age) in now.items():
        if pid not in seen or seen[pid][0] != name:
            seen[pid] = (name, t - age)
    for pid in [p for p in seen if p not in now]:
        name, start = seen.pop(pid)
        secs = round(t - start)
        if secs >= 60:
            emit({"t": "jobDone", "name": name, "kind": JOBS[name], "secs": secs})


def my_session():
    sid = os.environ.get("XDG_SESSION_ID")
    if sid:
        return sid
    try:
        r = subprocess.run(["loginctl", "list-sessions", "--no-legend"], capture_output=True, text=True, timeout=5)
        for l in r.stdout.splitlines():
            f = l.split()
            if len(f) >= 3 and f[2] == os.environ.get("USER", ""):
                return f[0]
    except (OSError, subprocess.SubprocessError):
        pass
    return ""


async def lock_watch():
    """DMS sets logind's LockedHint while its lock screen is up."""
    sid = await asyncio.to_thread(my_session)
    if not sid:
        return
    def locked():
        try:
            r = subprocess.run(["loginctl", "show-session", sid, "-p", "LockedHint", "--value"],
                               capture_output=True, text=True, timeout=5)
            return r.stdout.strip() == "yes"
        except (OSError, subprocess.SubprocessError):
            return None
    def path():
        try:
            r = subprocess.run(["busctl", "--system", "call", "org.freedesktop.login1", "/org/freedesktop/login1",
                                "org.freedesktop.login1.Manager", "GetSession", "s", sid],
                               capture_output=True, text=True, timeout=5)
            return r.stdout.split('"')[1] if '"' in r.stdout else ""
        except (OSError, subprocess.SubprocessError):
            return ""
    was, since = await asyncio.to_thread(locked), time.monotonic()
    obj = await asyncio.to_thread(path)
    # logind signals a change of LockedHint; asked again only then (and when
    # the monitor ends, after a pause)
    while True:
        if obj:
            async for line in lines("gdbus", "monitor", "--system", "--dest", "org.freedesktop.login1", "--object-path", obj):
                if "LockedHint" not in line:
                    continue
                now = await asyncio.to_thread(locked)
                if now is not None and was is not None and now != was:
                    emit({"t": "locked", "on": now, "away": round(time.monotonic() - since)})
                    since = time.monotonic()
                if now is not None:
                    was = now
        await asyncio.sleep(30)


async def usb_watch():
    """A USB drive plugged in: udev's block event for the whole disk."""
    proc = await asyncio.create_subprocess_exec(
        "udevadm", "monitor", "--udev", "--subsystem-match=block", "--property",
        stdout=asyncio.subprocess.PIPE, stderr=asyncio.subprocess.DEVNULL, stdin=asyncio.subprocess.DEVNULL)
    ev = {}
    try:
        async for raw in proc.stdout:
            line = raw.decode(errors="replace").strip()
            if line:
                if "=" in line:
                    k, v = line.split("=", 1)
                    ev[k] = v
                continue
            if ev.get("ACTION") == "add" and ev.get("DEVTYPE") == "disk" and ev.get("ID_BUS") == "usb":
                name = (ev.get("ID_VENDOR", "") + " " + ev.get("ID_MODEL", "")).replace("_", " ").strip()
                emit({"t": "usb", "name": name or "USB"})
            ev = {}
    finally:
        if proc.returncode is None:
            proc.kill()


def mic_users():
    """Programs recording from a real input (cava and friends listen to the
    output's monitor, that does not count)."""
    try:
        r = subprocess.run(["pactl", "-f", "json", "list", "source-outputs"], capture_output=True, text=True, timeout=5)
        outs = json.loads(r.stdout or "[]")
        r = subprocess.run(["pactl", "-f", "json", "list", "sources"], capture_output=True, text=True, timeout=5)
        monitors = {s["index"] for s in json.loads(r.stdout or "[]") if s.get("name", "").endswith(".monitor")}
    except (OSError, subprocess.SubprocessError, ValueError):
        return None
    names = []
    for o in outs:
        if o.get("source") in monitors or o.get("corked"):
            continue
        p = o.get("properties") or {}
        names.append(p.get("application.name") or p.get("application.process.binary") or "?")
    return names


async def mic_watch():
    was = False
    async def check():
        nonlocal was
        users = await asyncio.to_thread(mic_users)
        if users is not None:
            on = bool(users)
            if on != was:
                emit({"t": "mic", "on": on, "by": users[0] if users else ""})
            was = on
    await check()
    # pactl reports each stream that starts or ends; only then the list is read
    while True:
        async for line in lines("pactl", "subscribe"):
            if "source-output" in line:
                await asyncio.sleep(0.3)          # a few events come together
                await check()
        await asyncio.sleep(30)


# ── the Kuro wallpaper: dark and light, swapped against the mode ────
# Recognised by content (a profile keeps its own copy as wallpaper.png).
# Looked for as ~/Pictures/Wallpapers/*kuro-dunkel.png and *kuro-hell.png;
# without them nothing is swapped.
def _kuro_wall(kind):
    found = sorted((HOME / "Pictures/Wallpapers").glob(f"*kuro-{kind}.png"))
    return found[0] if found else HOME / f"Pictures/Wallpapers/kuro-{kind}.png"


KURO_WALLS = {"dunkel": _kuro_wall("dunkel"), "hell": _kuro_wall("hell")}


def file_hash(p):
    try:
        return hashlib.sha1(Path(p).read_bytes()).hexdigest()
    except OSError:
        return None


async def kuro_wall():
    hashes = {file_hash(p): k for k, p in KURO_WALLS.items()}
    hashes.pop(None, None)
    if not hashes:
        return
    seen = (None, None)
    sent = None
    # DMS writes these when the wallpaper or the mode changes: asked only then,
    # and once a minute in case
    marks = [HOME / ".local/state/DankMaterialShell/session.json", HOME / ".cache/DankMaterialShell/dms-colors.json"]
    def stamp():
        out = []
        for m in marks:
            try:
                out.append(m.stat().st_mtime)
            except OSError:
                out.append(None)
        return out
    last, asked = None, 0.0
    while True:
        st = stamp()
        if st == last and time.monotonic() - asked < 60:
            await asyncio.sleep(2)
            continue
        last, asked = st, time.monotonic()
        path = await asyncio.to_thread(wallpaper)
        try:
            mtime = Path(path).stat().st_mtime if path else None
        except OSError:
            mtime = None
        if (path, mtime) != seen[0]:
            seen = ((path, mtime), hashes.get(await asyncio.to_thread(file_hash, path)) if path else None)
        variant = seen[1]
        def mode():
            try:
                r = subprocess.run(["dms", "ipc", "call", "theme", "getMode"], capture_output=True, text=True, timeout=5)
                return r.stdout.strip()
            except (OSError, subprocess.SubprocessError):
                return ""
        light = (await asyncio.to_thread(mode)) == "light"
        if variant:
            # contrast: a light shell (white frame and windows) over the black
            # ring, a dark one over the white ring (the dark and the light Kuro wallpaper)
            want = "dunkel" if light else "hell"
            if variant != want:
                # the other one for this mode; the profile saves it as its own again
                await asyncio.to_thread(subprocess.run, ["dms", "ipc", "call", "wallpaper", "set", str(KURO_WALLS[want])],
                                        capture_output=True, timeout=10)
                await asyncio.sleep(1)
                last = None
                continue
        state = (bool(variant), light)
        if state != sent:
            sent = state
            emit({"t": "kuroWall", "on": bool(variant), "light": light})
        await asyncio.sleep(2)


BACKDROP_CHECK = asyncio.Event()     # set when somebody may have rebuilt a background surface


async def backdrop_order():
    """In niri's background layer the surface opened last lies on top. When a
    surface of somebody else's is listed after ours (a visualizer rebuilt by a
    theme or profile switch), the scene builds its own again, at most every
    15 s. niri has no event for layer surfaces: looked at after DMS changed
    its settings or restarted, a few seconds after the start, and otherwise
    every 5 minutes."""
    last = -1e9
    BACKDROP_CHECK.set()
    while True:
        try:
            await asyncio.wait_for(BACKDROP_CHECK.wait(), 300)
            BACKDROP_CHECK.clear()
            await asyncio.sleep(4)          # the other one needs a moment to come up
        except asyncio.TimeoutError:
            pass
        try:
            r = await asyncio.to_thread(subprocess.run, ["niri", "msg", "-j", "layers"],
                                        capture_output=True, text=True, timeout=5)
            names = [l["namespace"] for l in json.loads(r.stdout or "[]") if l.get("layer") == "Background"]
        except (OSError, subprocess.SubprocessError, ValueError):
            continue
        ours = [i for i, n in enumerate(names) if n in ("aibou", "aibou-wall")]
        if not ours:
            continue
        # the wallpaper and DMS desktop widgets may lie below; anything else after ours is in the way
        later = [n for n in names[min(ours):] if n not in ("aibou", "aibou-wall")]
        if later and time.monotonic() - last > 15:
            last = time.monotonic()
            log("restack: over us were", later)
            emit({"t": "restack"})


async def dms_errors():
    """Error lines from DMS's own log (its QML or its Go backend), at most one
    report in ten minutes; warnings are left out, there are too many."""
    proc = await asyncio.create_subprocess_exec(
        "journalctl", "--user", "-u", "dms.service", "-f", "-n", "0", "-o", "cat",
        stdout=asyncio.subprocess.PIPE, stderr=asyncio.subprocess.DEVNULL, stdin=asyncio.subprocess.DEVNULL)
    last = -1e9
    try:
        async for raw in proc.stdout:
            line = raw.decode(errors="replace").strip()
            if " ERROR" not in " " + line:
                continue
            now = time.monotonic()
            if now - last < 600:
                continue
            last = now
            what = re.sub(r"^.*?ERROR:?\s*", "", line)[:80]
            emit({"t": "trouble", "kind": "dms", "name": what})
    finally:
        if proc.returncode is None:
            proc.kill()


UNIT_FAILED = "MESSAGE_ID=d9b373ed55a64feb8242e02dbe79a49c"     # systemd: "… Failed with result …"


async def failed_units():
    """Services that failed since he started: systemd logs each failure under
    one message id. Counted only when the unit is still failed a few seconds
    later (one that restarts by itself is not)."""
    def still_failed(unit, user):
        try:
            r = subprocess.run(["systemctl", *(["--user"] if user else []), "is-failed", "--quiet", unit],
                               capture_output=True, timeout=10)
            return r.returncode == 0
        except (OSError, subprocess.SubprocessError):
            return False
    uid = str(os.getuid())
    while True:
        async for line in lines("journalctl", "-f", "-n", "0", "-o", "json",
                                "--output-fields=UNIT,USER_UNIT,_UID", UNIT_FAILED):
            try:
                e = json.loads(line)
            except ValueError:
                continue
            user = bool(e.get("USER_UNIT"))
            unit = e.get("USER_UNIT") or e.get("UNIT")
            if not unit or (user and e.get("_UID") != uid):
                continue
            await asyncio.sleep(3)
            if await asyncio.to_thread(still_failed, unit, user):
                emit({"t": "trouble", "kind": "unit", "name": re.sub(r"\.service$", "", unit)})
        await asyncio.sleep(30)


BAR_SIG = [None]     # the taken rows beside the faces at the last look


def bar_spot(x, w, top, bottom, need, skip=None, gaps=False):
    """The lowest stretch of the bar between `top` and `bottom` (screen
    coordinates) without icons that is at least `need` tall, from a capture of
    the bar: a row is free when its middle part has no strong contrast. Rows in
    `skip` (where his own face is now) count as free. Returns the centre of his
    face, low in that stretch, or None."""
    x, w, top, bottom, need = (int(round(v)) for v in (x, w, top, bottom, need))
    try:
        r = subprocess.run(["grim", "-g", f"{x},{top} {w}x{bottom - top}", "-t", "ppm", "-"],
                           capture_output=True, timeout=5)
        head, dims, _max, px = r.stdout.split(b"\n", 3)
        cw, ch = map(int, dims.split())
    except (OSError, subprocess.SubprocessError, ValueError):
        return None
    pad = 8
    lo, hi = int(cw * 0.16), int(cw * 0.84)
    free = []
    # skip: one [from, to] or a list of them
    spans = [skip] if skip and not isinstance(skip[0], (list, tuple)) else (skip or [])
    for y in range(ch):
        if any(s[0] <= top + y <= s[1] for s in spans):
            free.append(True)
            continue
        row = px[(y * cw + lo) * 3:(y * cw + hi) * 3]
        lum = [(row[i] * 299 + row[i + 1] * 587 + row[i + 2] * 114) // 1000 for i in range(0, len(row) - 2, 3)]
        free.append(bool(lum) and max(lum) - min(lum) < 40)
    if gaps:
        # which rows are taken outside the faces: has that pattern changed since
        # the last look (icons moved, one came or went)? Then something may sit
        # under a face now, and the scene looks again without them (dirty)
        sig = (top, bottom, tuple(f for y, f in enumerate(free) if not any(s[0] <= top + y <= s[1] for s in spans)))
        dirty = bool(spans) and BAR_SIG[0] is not None and BAR_SIG[0] != sig
        BAR_SIG[0] = sig if spans else None
        # every free stretch, bottom up, as [top, bottom] of the room in it
        out, end = [], None
        for y in range(ch - 1, -2, -1):
            if y >= 0 and free[y]:
                if end is None:
                    end = y
            else:
                if end is not None and end - y >= 2 * pad + 4:
                    out.append([top + y + 1 + pad, top + end - pad])
                end = None
        return {"gaps": out, "dirty": dirty}
    end = None
    for y in range(ch - 1, -1, -1):
        if free[y]:
            if end is None:
                end = y
            if end - y + 1 >= need + 2 * pad:
                return top + end - pad - need / 2
        else:
            end = None
    return None


def wallpaper():
