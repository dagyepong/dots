PLAYERS = {}                # player -> status, from `playerctl --follow`


def playing():
    return "Playing" in PLAYERS.values()


def all_players():
    try:
        r = subprocess.run(["playerctl", "-a", "--format", "{{playerName}}\t{{status}}", "status"],
                           capture_output=True, text=True, timeout=5)
        return dict(l.split("\t", 1) for l in r.stdout.splitlines() if "\t" in l)
    except (OSError, subprocess.SubprocessError, ValueError):
