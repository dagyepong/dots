def persona(skin, lang, desktop=False):
    text = FIGURES.get(skin, FIGURES["kuro"])[lang] + "\n" + RULES[lang]
    if desktop:
        text += "\n\n" + DESKTOP[lang]
        try:
            text += "\n\n# Skill desktop\n" + SKILL.read_text()
        except OSError:
            pass
    return text.replace("{user}", user_name())


def blocked(cmd):
    for rx, why in blocked_rules():
        if re.search(rx, cmd):
            return why
    return None


def split_actions(text):
    """The answer without its action blocks, and the blocks."""
    acts = [m.strip() for m in ACTION_RX.findall(text) if m.strip()]
    clean = ACTION_RX.sub("", text)
    clean = re.sub(r"\n{3,}", "\n\n", clean).strip()
    return clean, acts


HISTORY = STATE / "chat.json"
CHATVIEW = STATE / "chatview.json"     # where the window was last emptied


class Chat:
    """One Claude session that keeps running between messages
    (`claude -p --input-format stream-json`). Starting the CLI costs about
    three seconds, a running session answers its first word in under one.
    The session remembers the conversation; a new model or figure starts a
    new session and gets the last lines handed over."""

    def __init__(self):
        self.history = []
        self.busy = False
        self.proc = None
        self.key = None
        self.model_override = None
        self.handover = False                # a new session still needs the last lines
        self.lock = asyncio.Lock()
        self.actions = {}                    # id -> command proposed and not yet run
        self.running_action = None           # a confirmed action still running
        self.serial = 0
        # the conversation survives restarts: the window shows it again, a new
        # session gets the last lines handed over
        try:
            self.history = [tuple(x) for x in json.loads(HISTORY.read_text())][-24:]
        except (OSError, ValueError, TypeError):
            self.history = []

    def clear_view(self):
        """The window was emptied: the history stays (and goes on into new
        sessions), but what was said up to here is not shown again after a restart."""
        try:
            CHATVIEW.write_text(json.dumps({"after": list(self.history[-1]) if self.history else None}, ensure_ascii=False))
        except OSError as e:
            log("chat view not saved:", repr(e))

    def shown(self):
        """The part of the history the window shows after a restart."""
        try:
            after = json.loads(CHATVIEW.read_text()).get("after")
        except (OSError, ValueError, AttributeError):
            after = None
        if after:
            mark = tuple(after)
            for i in range(len(self.history) - 1, -1, -1):
                if self.history[i] == mark:
                    return self.history[i + 1:]
        return self.history

    def save(self):
        try:
            tmp = HISTORY.with_suffix(".tmp")
            tmp.write_text(json.dumps(self.history, ensure_ascii=False))
            tmp.replace(HISTORY)
        except OSError as e:
            log("history not saved:", repr(e))

    def wanted(self):
        model = self.model_override or SETTINGS.get("model") or os.environ.get("AIBOU_MODEL", "haiku")
        skin = SETTINGS.get("skin1") or "kuro"
        lang = language() if language() in ("de", "ja") else "en"
        # off unless switched on: it may send file contents to the chat provider
        desktop = SETTINGS.get("desktopHelp", False) is True
        return (model, skin if skin in FIGURES else "kuro", lang, desktop)

    async def stop(self):
        proc, self.proc = self.proc, None
        if proc and proc.returncode is None:
            try:
                proc.stdin.close()
                await asyncio.wait_for(proc.wait(), 3)
            except (asyncio.TimeoutError, OSError, BrokenPipeError):
                proc.kill()

    async def ensure(self):
        """A running session for the current model and figure (Claude Code only;
        the other providers need none)."""
        key = self.wanted()
        if provider(key[0]):
            if self.proc:
                await self.stop()
            if key != self.key:
                self.key = key
                emit({"t": "model", "name": key[0]})
            return False
        if self.proc and self.proc.returncode is None and key == self.key:
            return False
        await self.stop()
        model, skin, lang, desktop = key
        self.key = key
        self.handover = bool(self.history)
        if desktop:
            # no built-in tools: Claude Code lets read-only shell commands such
            # as cat run by themselves in folders it may read, past any rule.
            # It gets the same three tools as the other providers instead, from
            # this file as an MCP server (`aiboud --mcp`), with the same checks.
            mcp = {"mcpServers": {"aibou": {"command": sys.executable, "args": [str(Path(__file__).resolve()), "--mcp"]}}}
            tools = ["--tools", "", "--mcp-config", json.dumps(mcp), "--strict-mcp-config",
                     "--permission-mode", "dontAsk",
                     "--allowedTools", *[f"mcp__aibou__{t['name']}" for t in API_TOOLS]]
        else:
            tools = ["--tools", ""]
        self.proc = await asyncio.create_subprocess_exec(
            "claude", "-p", "--model", model, *tools, "--no-session-persistence",
            "--setting-sources", "", "--system-prompt", persona(skin, lang, desktop),
            "--input-format", "stream-json", "--output-format", "stream-json",
            "--verbose", "--include-partial-messages",
            stdin=asyncio.subprocess.PIPE, stdout=asyncio.subprocess.PIPE,
            stderr=asyncio.subprocess.DEVNULL, cwd=str(STATE), limit=1 << 22)
        emit({"t": "model", "name": model})
        return True

    async def warm(self):
        """Start the session ahead of the first message (chat window opened)."""
        if not provider(self.wanted()[0]) and not shutil.which("claude"):
            return
        async with self.lock:
            try:
                await self.ensure()
            except OSError as e:
                log("warm failed:", repr(e))

    async def set_model(self, name):
        """A model or provider picked in the chat window; it stays the choice
        (kept like the chat's other changes, see choose())."""
        if name not in MODELS and not provider(name):
            return
        self.model_override = None
        choose({"model": name})
        if not self.busy:
            await self.warm()
        else:
            emit({"t": "model", "name": name})

    async def forget(self):
        self.history.clear()
        self.save()
        if not self.busy:
            async with self.lock:
                await self.stop()
            await self.warm()

    async def ask(self, text, shown=True):
        if self.busy:
            return
        self.busy = True
        emit({"t": "thinking"})
        try:
            p = provider(self.wanted()[0])
            if not p and not shutil.which("claude"):
                emit({"t": "say", "mood": "sad", "text": NO_CLAUDE.get(language(), NO_CLAUDE["en"])})
                return
            if p:
                result = await self.ask_api(p, text)
            else:
                async with self.lock:
                    await self.ensure()
                    lang = self.key[2]
                    prompt = text
                    if self.handover and self.history:
                        who = user_name()
                        me = {"de": "Du", "ja": "あなた"}.get(lang, "You")
                        convo = "".join(f"{who if r == 'user' else me}: {t}\n" for r, t in self.history[-12:])
                        head = {"de": "Bisheriges Gespräch", "ja": "これまでの会話"}.get(lang, "Conversation so far")
                        prompt = f"{head}:\n{convo}\n{text}"
                    self.handover = False
                    msg = {"type": "user", "message": {"role": "user", "content": prompt}}
                    self.proc.stdin.write((json.dumps(msg, ensure_ascii=False) + "\n").encode())
                    await self.proc.stdin.drain()
                    result = await asyncio.wait_for(self.read_answer(), timeout=180)
            mood, level = "neutral", 0
            m = re.match(r"\s*\[([A-Za-z]+)([1-3])?\]\s*", result)
            if m:
                if m.group(1).lower() in MOODS:
                    mood = m.group(1).lower()
                    level = int(m.group(2) or 0)
                result = result[m.end():]
            result, acts = split_actions(result)
            self.history += [("user", text), ("aibou", result + "".join(f"\n[Aktion] {a}" for a in acts))]
            self.history = self.history[-24:]
            self.save()
            emit({"t": "say", "text": result, "mood": mood, "level": level})
            if acts:
                out = []
                for a in acts:
                    self.serial += 1
                    aid = f"a{self.serial}"
                    why = blocked(a)
                    if not why:
                        self.actions[aid] = a
                    out.append({"id": aid, "cmd": a, "blocked": why or ""})
                emit({"t": "actions", "list": out})
        except Exception as e:  # noqa: BLE001  any failure becomes a sad face, not a dead daemon
            log("chat failed:", repr(e))
            await self.stop()
            emit({"t": "error", "text": str(e)[:200]})
        finally:
            self.busy = False

    async def ask_api(self, p, text):
        """An answer from one of the other providers: the conversation so far as
        messages, the answer streamed into the window like Claude's. With desktop
        help on, it may read files and run read-only commands (API_TOOLS), up to
        eight rounds; changes stay action cards as with Claude."""
        model, skin, lang, desktop = self.wanted()
        if not p.get("model"):
            raise RuntimeError(f"{p.get('name')}: " + ("kein Modell eingetragen" if lang == "de" else "no model set"))
        key = await asyncio.to_thread(provider_key, p.get("id", ""))
        local = re.match(r"https?://(localhost|127\.|\[::1\])", p.get("url") or "")
        if not key and not local:
            raise RuntimeError(f"{p.get('name')}: " + ("kein Schlüssel im Schlüsselbund (Einstellungen)" if lang == "de"
                                                       else "no key in the keyring (settings)"))
        messages = [{"role": "user" if r == "user" else "assistant", "content": t} for r, t in self.history[-12:]]
        messages.append({"role": "user", "content": text})
        # the Anthropic interface wants user and assistant in turns, starting with the user
        while messages and messages[0]["role"] != "user":
            messages.pop(0)
        out = Shown()
        loop = asyncio.get_running_loop()
        tools = API_TOOLS if desktop else None
        system = persona(skin, lang, desktop)
        anthropic = p.get("kind") == "anthropic"
        for _ in range(8):
            got = await asyncio.wait_for(asyncio.to_thread(
                api_stream, p, key, system, messages,
                lambda piece: loop.call_soon_threadsafe(out.add, piece), tools), timeout=180)
            await asyncio.sleep(0)               # the last pieces queued on the loop
            if not got["calls"]:
                break
            # the tool calls go back into the conversation with their results
            if anthropic:
                blocks = ([{"type": "text", "text": got["text"]}] if got["text"] else []) + [
                    {"type": "tool_use", "id": c["id"], "name": c["name"], "input": c["args"]} for c in got["calls"]]
                messages.append({"role": "assistant", "content": blocks})
            else:
                messages.append({"role": "assistant", "content": got["text"] or None, "tool_calls": [
                    {"id": c["id"], "type": "function", "function": {"name": c["name"], "arguments": json.dumps(c["args"])}}
                    for c in got["calls"]]})
            results = []
            for c in got["calls"]:
                what = c["args"].get("command") or c["args"].get("path") or ""
                emit({"t": "tool", "name": c["name"], "what": str(what).replace(str(HOME), "~")[:120]})
                res = await asyncio.to_thread(run_tool, c["name"], c["args"])
                results.append((c, res))
            if anthropic:
                messages.append({"role": "user", "content": [
                    {"type": "tool_result", "tool_use_id": c["id"], "content": res} for c, res in results]})
            else:
                for c, res in results:
                    messages.append({"role": "tool", "tool_call_id": c["id"], "content": res})
            if out.text and not out.text.endswith("\n"):
                out.text += "\n\n"
        return out.text.strip()

    async def run(self, aid, cmd):
        """Run an action the user confirmed, then hand the result to the session."""
        if self.actions.get(aid) != cmd:
            emit({"t": "ran", "id": aid, "code": -1, "out": "unknown action"})
            return
        del self.actions[aid]
        why = blocked(cmd)
        if why:
            emit({"t": "ran", "id": aid, "code": -1, "out": why})
            return
        env = dict(os.environ)
        env["PATH"] = f"{HOME}/.local/bin:{HOME}/bin:" + env.get("PATH", "")
        # long ones (a rebuild) may take a while: the card shows the last lines
        # as they come, and only after 15 minutes does it give up
        chunks = []
        try:
            proc = await asyncio.create_subprocess_exec(
                "bash", "-c", cmd, stdout=asyncio.subprocess.PIPE, stderr=asyncio.subprocess.STDOUT,
                stdin=asyncio.subprocess.DEVNULL, cwd=str(HOME), env=env, start_new_session=True)
            self.running_action = proc

            async def pump():
                last = 0.0
                while True:
                    piece = await proc.stdout.read(4096)
                    if not piece:
                        break
                    chunks.append(piece.decode("utf-8", "replace"))
                    now = time.monotonic()
                    if now - last > 1:
                        last = now
                        tail = re.sub(r"\x1b\[[0-9;]*m", "", "".join(chunks))[-600:]
                        emit({"t": "ranOut", "id": aid, "out": tail})
                await proc.wait()
            await asyncio.wait_for(pump(), timeout=900)
            code = proc.returncode
        except asyncio.TimeoutError:
            try:
                os.killpg(proc.pid, 15)
            except ProcessLookupError:
                pass
            code = -1
            chunks.append("\ntimeout after 15 min")
        except OSError as e:
            code = -1
            chunks.append(str(e))
        finally:
            self.running_action = None
        out = "".join(chunks)
        out = re.sub(r"\x1b\[[0-9;]*m", "", out).strip()
        emit({"t": "ran", "id": aid, "code": code, "out": out[-600:]})
        lang = self.key[2] if self.key else "de"
        head = {"de": "[Ergebnis]", "ja": "[結果]"}.get(lang, "[Result]")
        # he may be answering something else right now; the result waits
        for _ in range(600):
            if not self.busy:
                break
            await asyncio.sleep(0.2)
        await self.ask(f"{head} `{cmd}` → exit {code}\n{out[-2500:]}", shown=False)

    async def read_answer(self):
        """Pass the text on as it arrives (Shown); tool use shows as a short note."""
        out = Shown()
        messages = 0
        while True:
            raw = await self.proc.stdout.readline()
            if not raw:
                raise RuntimeError("claude ended")
            try:
                ev = json.loads(raw)
            except ValueError:
                continue
            kind = ev.get("type")
            if kind == "stream_event":
                e = ev.get("event", {})
                if e.get("type") == "message_start":
                    messages += 1
                    if messages > 1 and out.text and not out.text.endswith("\n"):
                        out.text += "\n\n"
                elif e.get("type") == "content_block_delta" and e.get("delta", {}).get("type") == "text_delta":
                    out.add(e["delta"].get("text", ""))
            elif kind == "assistant":
                for block in (ev.get("message") or {}).get("content", []):
                    if block.get("type") == "tool_use":
                        emit({"t": "tool", "name": str(block.get("name")).split("__")[-1], "what": tool_note(block)})
            elif kind == "result":
                if ev.get("is_error"):
                    raise RuntimeError(ev.get("result") or "error")
                return (out.text or ev.get("result") or "").strip()


class Shown:
    """What of an answer is shown while it streams: the mood tag at the start
    is held back, an action block too (it becomes a card)."""

    def __init__(self):
        self.text = ""
        self.shown = 0

    def add(self, piece):
        self.text += piece
        m = re.match(r"\s*\[(\w*)(\]\s*)?", self.text)
        if m and not m.group(2):
            return                          # the tag is not complete yet
        visible = self.text[m.end() if m else 0:]
        cut = visible.find("```")
        if cut >= 0 and re.match(r"```(aktion|action)?$", visible[cut:cut + 9].split("\n")[0]):
            visible = visible[:cut]
        if len(visible) > self.shown:
            emit({"t": "delta", "text": visible[self.shown:]})
            self.shown = len(visible)


# ── other AI providers ────────────────────────────────────────────
# Set up on Aibou's settings page (list "providers"); the chat model is then
# "p:<id>". Keys live in the keyring: secret-tool, service aibou, provider <id>.

def provider(name):
    if not isinstance(name, str) or not name.startswith("p:"):
        return None
    for p in SETTINGS.get("providers") or []:
        if isinstance(p, dict) and p.get("id") == name[2:]:
            return p
    return None


def provider_key(pid):
    try:
        r = subprocess.run(["secret-tool", "lookup", "service", "aibou", "provider", pid],
                           capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.SubprocessError):
        return ""
    return r.stdout.strip()


def api_stream(p, key, system, messages, on_piece, tools=None):
    """One answer from an OpenAI-compatible or the Anthropic interface, as it
    streams (server-sent events). Blocking: runs in a thread. With `tools`
    (name, description, parameters as JSON schema) the model may call them:
    returns {"text", "calls": [{"id", "name", "args"}]}."""
    kind = p.get("kind")
    if kind == "anthropic":
        url = (p.get("url") or "https://api.anthropic.com").rstrip("/") + "/v1/messages"
        headers = {"content-type": "application/json", "x-api-key": key, "anthropic-version": "2023-06-01"}
        body = {"model": p.get("model"), "max_tokens": 2048, "system": system, "messages": messages, "stream": True}
        if tools:
            body["tools"] = [{"name": t["name"], "description": t["description"], "input_schema": t["parameters"]} for t in tools]
    else:
        url = (p.get("url") or "https://api.openai.com/v1").rstrip("/") + "/chat/completions"
        headers = {"content-type": "application/json"}
        if key:
            headers["authorization"] = "Bearer " + key
        body = {"model": p.get("model"), "messages": [{"role": "system", "content": system}] + messages, "stream": True}
        if tools:
            body["tools"] = [{"type": "function", "function": t} for t in tools]
    req = urllib.request.Request(url, data=json.dumps(body).encode(), headers=headers, method="POST")
    text = []
    calls = {}                                   # index -> {"id", "name", "args" (json text)}
    try:
        with urllib.request.urlopen(req, timeout=120) as r:
            for raw in r:
                line = raw.decode("utf-8", "replace").strip()
                if not line.startswith("data:"):
                    continue
                data = line[5:].strip()
                if data == "[DONE]":
                    break
                try:
                    ev = json.loads(data)
                except ValueError:
                    continue
                if kind == "anthropic":
                    t = ev.get("type")
                    if t == "content_block_start" and (ev.get("content_block") or {}).get("type") == "tool_use":
                        cb = ev["content_block"]
                        calls[ev.get("index", len(calls))] = {"id": cb.get("id"), "name": cb.get("name"), "args": ""}
                    elif t == "content_block_delta":
                        d = ev.get("delta") or {}
                        if d.get("type") == "input_json_delta":
                            c = calls.get(ev.get("index"))
                            if c is not None:
                                c["args"] += d.get("partial_json", "")
                        elif d.get("text"):
                            text.append(d["text"]); on_piece(d["text"])
                    elif t == "error":
                        raise RuntimeError((ev.get("error") or {}).get("message", "error"))
                else:
                    if ev.get("error"):
                        raise RuntimeError(str(ev["error"].get("message", ev["error"]))[:200])
                    for ch in ev.get("choices") or []:
                        d = ch.get("delta") or {}
                        if d.get("content"):
                            text.append(d["content"]); on_piece(d["content"])
                        for tc in d.get("tool_calls") or []:
                            c = calls.setdefault(tc.get("index", 0), {"id": None, "name": "", "args": ""})
                            if tc.get("id"):
                                c["id"] = tc["id"]
                            f = tc.get("function") or {}
                            if f.get("name"):
                                c["name"] = f["name"]
                            c["args"] += f.get("arguments") or ""
    except urllib.error.HTTPError as e:
        detail = e.read()[:300].decode("utf-8", "replace")
        raise RuntimeError(f"{p.get('name')}: HTTP {e.code} {detail}") from None
    except urllib.error.URLError as e:
        raise RuntimeError(f"{p.get('name')}: {e.reason}") from None
    out = []
    for i in sorted(calls):
        c = calls[i]
        try:
            args = json.loads(c["args"] or "{}")
        except ValueError:
            args = {}
        out.append({"id": c["id"] or f"call{i}", "name": c["name"], "args": args})
    return {"text": "".join(text), "calls": out}


