class Shell:
    """Runs what the user types after "!" in the chat window, in bash, in a
    directory of its own that `cd` changes. Output goes back as it comes
    (ANSI colours stripped), at most two minutes; Ctrl+C stops it."""
    ANSI = re.compile(r"\x1b\[[0-9;?]*[ -/]*[@-~]|\x1b\][^\x07]*\x07|\r")

    def __init__(self):
        self.cwd = HOME
        self.proc = None

    @staticmethod
    def say(de, en, ja=None):
        lang = language()
        return de if lang == "de" else ja if lang == "ja" and ja else en

    async def run(self, rid, cmd):
        if self.proc and self.proc.returncode is None:
            emit({"t": "shellOut", "id": rid, "text": self.say("(es läuft noch ein Befehl, Strg+C stoppt ihn)", "(a command is still running, Ctrl+C stops it)", "(まだコマンドが動いています。Ctrl+C で止まります)") + "\n"})
            emit({"t": "shellDone", "id": rid, "code": 1})
            return
        m = re.fullmatch(r"cd(?:\s+(.*))?", cmd.strip())
        if m:
            target = Path(os.path.expanduser((m.group(1) or "~").strip().strip("\"'")))
            target = target if target.is_absolute() else self.cwd / target
            if target.is_dir():
                self.cwd = target.resolve()
                emit({"t": "shellOut", "id": rid, "text": str(self.cwd).replace(str(HOME), "~", 1) + "\n"})
                emit({"t": "shellDone", "id": rid, "code": 0})
            else:
                emit({"t": "shellOut", "id": rid, "text": f"cd: {target}: " + self.say("kein Verzeichnis", "not a directory", "ディレクトリではありません") + "\n"})
                emit({"t": "shellDone", "id": rid, "code": 1})
            return
        env = dict(os.environ, TERM="dumb", NO_COLOR="1", PAGER="cat", GIT_PAGER="cat", SYSTEMD_PAGER="")
        self.proc = await asyncio.create_subprocess_exec(
            "bash", "-c", cmd, cwd=str(self.cwd), env=env, stdin=asyncio.subprocess.DEVNULL,
            stdout=asyncio.subprocess.PIPE, stderr=asyncio.subprocess.STDOUT, start_new_session=True)
        proc = self.proc
        sent = 0
        try:
            async def pump():
                nonlocal sent
                while True:
                    chunk = await proc.stdout.read(4096)
                    if not chunk:
                        break
                    if sent > 200000:
                        continue
                    text = self.ANSI.sub("", chunk.decode(errors="replace"))
                    sent += len(text)
                    emit({"t": "shellOut", "id": rid, "text": text})
                await proc.wait()
            await asyncio.wait_for(pump(), timeout=120)
        except asyncio.TimeoutError:
            self.kill()
            emit({"t": "shellOut", "id": rid, "text": "\n" + self.say("(nach 2 Minuten abgebrochen)", "(stopped after 2 minutes)", "(2 分たったので止めました)") + "\n"})
            await proc.wait()
        emit({"t": "shellDone", "id": rid, "code": proc.returncode if proc.returncode is not None else -1})

    def kill(self):
        if self.proc and self.proc.returncode is None:
            try:
                os.killpg(self.proc.pid, 15)
            except ProcessLookupError:
                pass


