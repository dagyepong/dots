def output_size():
    try:
        r = subprocess.run(["niri", "msg", "-j", "outputs"], capture_output=True, text=True, timeout=5)
        outs = json.loads(r.stdout or "{}")
        want = os.environ.get("AIBOU_OUTPUT")
        for name, o in outs.items():
            if want and name != want:
                continue
            lg = o.get("logical") or {}
            return (lg.get("width"), lg.get("height"))
    except (OSError, subprocess.SubprocessError, ValueError):
        pass
    return None


async def niri_events():
    windows = layout.windows
    while True:
        async for line in lines("niri", "msg", "--json", "event-stream"):
            try:
                ev = json.loads(line)
            except ValueError:
                continue
            (kind, data), = ev.items()
            if kind == "CastsChanged":
                CASTS[0] = (ev[kind] or {}).get("casts") or []
                CASTS_CHANGED.set()
            elif kind == "WindowsChanged":
                windows.clear()
                windows.update({w["id"]: w for w in data["windows"]})
                layout.mark()
            elif kind == "WindowOpenedOrChanged":
                w = data["window"]
                was = windows.get(w["id"], {}).get("is_focused")
                windows[w["id"]] = w
                layout.mark()
                if w.get("is_focused") and not was:
                    activity.poke()
                    emit({"t": "focus", "id": w["id"], "app": w.get("app_id"), "title": w.get("title")})
            elif kind == "WindowLayoutsChanged":
                for wid, lay in data.get("changes", []):
                    if wid in windows:
                        windows[wid]["layout"] = lay
                layout.mark()
            elif kind == "WindowFocusChanged":
                activity.poke()
                w = windows.get(data.get("id")) or {}
                emit({"t": "focus", "id": data.get("id"), "app": w.get("app_id"), "title": w.get("title")})
            elif kind == "WindowClosed":
                windows.pop(data.get("id"), None)
                layout.mark()
            elif kind == "WorkspacesChanged":
                layout.workspaces = {ws["id"]: ws for ws in data["workspaces"]}
                layout.mark()
                activity.poke()
            elif kind == "WorkspaceActivated":
                wid = data.get("id")
                out = layout.workspaces.get(wid, {}).get("output")
                for ws in layout.workspaces.values():
                    if ws.get("output") == out:
                        ws["is_active"] = ws["id"] == wid
                layout.mark()
                activity.poke()
            elif kind == "OverviewOpenedOrClosed":
                emit({"t": "overview", "open": data.get("is_open", False)})
        await asyncio.sleep(2)


async def notifications():
    match = "type='method_call',interface='org.freedesktop.Notifications',member='Notify'"
    while True:
        async for line in lines("busctl", "--user", "monitor", "--json=short", "--match", match):
            try:
                msg = json.loads(line)
                app, _rid, _icon, summary, body, _actions, hints, _timeout = msg["payload"]["data"]
            except (ValueError, KeyError, TypeError):
                continue
            urgency = (hints.get("urgency") or {}).get("data", 1)
            body = re.sub(r"<[^>]+>", "", body or "")
            emit({"t": "notify", "app": app, "summary": summary, "body": body[:300], "urgency": urgency})
        await asyncio.sleep(2)


