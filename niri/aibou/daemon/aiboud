async def read_commands():
    loop = asyncio.get_running_loop()
    reader = asyncio.StreamReader()
    await loop.connect_read_pipe(lambda: asyncio.StreamReaderProtocol(reader), sys.stdin)
    async for raw in reader:
        try:
            cmd = json.loads(raw)
        except ValueError:
            continue
        t = cmd.get("t")
        if t == "chat" and cmd.get("text", "").strip():
            asyncio.create_task(chat.ask(cmd["text"].strip()))
        elif t == "warm":
            asyncio.create_task(chat.warm())
        elif t == "model":
            asyncio.create_task(chat.set_model(cmd.get("name")))
        elif t == "clearView":
            chat.clear_view()
        elif t == "forget":
            asyncio.create_task(chat.forget())
        elif t == "run":
            asyncio.create_task(chat.run(cmd.get("id"), cmd.get("cmd", "")))
        elif t == "decline":
            chat.actions.pop(cmd.get("id"), None)
        elif t == "shell" and cmd.get("cmd", "").strip():
            asyncio.create_task(shell.run(cmd.get("id", ""), cmd["cmd"]))
        elif t == "shellKill":
            shell.kill()
        elif t == "buddies":
            change_buddies(int(cmd.get("delta", 0)))
        elif t == "pointerFast":
            POINTER_FAST[0] = bool(cmd.get("on"))
        elif t == "setOption":
            set_option(str(cmd.get("key", "")), cmd.get("value"))
        elif t == "frameBodies":
            asyncio.create_task(frame_host.send(json.dumps(cmd.get("list", []), separators=(",", ":"))))
        elif t == "barspot":
            try:
                y = await asyncio.to_thread(bar_spot, cmd["x"], cmd["w"], cmd["top"], cmd["bottom"],
                                            cmd["need"], cmd.get("skip"), bool(cmd.get("gaps")))
            except (KeyError, TypeError, ValueError):
                y = None
            if cmd.get("gaps"):
                emit({"t": "barspot", "gaps": (y or {}).get("gaps", []), "dirty": bool((y or {}).get("dirty"))})
            else:
                emit({"t": "barspot", "y": y})
    # The scene closed our stdin: it is gone, so are we.
    os._exit(0)


async def kept(watch):
    """Runs one watcher for good: if it fails, it is logged and started again
    after a pause, and the others go on."""
    while True:
        try:
            await watch()
            return
        except asyncio.CancelledError:
            raise
        except Exception as e:
            log("watcher", getattr(watch, "__name__", watch), "failed:", repr(e)[:200])
            await asyncio.sleep(5)


async def while_on(key, default, watch):
    """Runs a watcher only while its setting is on; switched off, it is
    stopped together with the programs it started."""
    task = None
    try:
        while True:
            on = option(key, default)
            if on and task is None:
                task = asyncio.create_task(kept(watch))
            elif not on and task is not None:
                task.cancel()
                task = None
            await asyncio.sleep(2)
    finally:
        if task is not None:
            task.cancel()


